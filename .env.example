# DATABASE
POSTGRES_DB=ai_translate_meeting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=Host=postgres;Port=5432;Database=ai_translate_meeting;Username=postgres;Password=postgres

# REDIS
REDIS_HOST=redis
REDIS_PORT=6379

# LIVEKIT
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_aitranslate_meeting_secret_key_32chars
LIVEKIT_TOKEN_TTL_MINUTES=60

# SUBTITLE SESSION JWT (must be a distinct random secret of at least 32 characters)
SUBTITLE_TOKEN_SIGNING_KEY=
SUBTITLE_TOKEN_TTL_MINUTES=10

# ADMISSION JWT (must be a distinct random secret of at least 32 characters; no fallback in production)
ADMISSION_TOKEN_SIGNING_KEY=
ADMISSION_HOST_TOKEN_TTL_MINUTES=240
ADMISSION_INVITE_TOKEN_TTL_MINUTES=15
ADMISSION_REQUEST_TOKEN_TTL_MINUTES=15

# PARTICIPANT SESSION JWT (must be a distinct random secret of at least 32 characters)
SESSION_TOKEN_SIGNING_KEY=
SESSION_TOKEN_TTL_MINUTES=60

# AI SERVICE
WHISPER_MODEL=base
# Whisper execution device: 'auto' (detects CUDA GPU with CTranslate2 else falls back to CPU), 'cuda', or 'cpu'
WHISPER_DEVICE=auto
# Whisper compute type: 'auto' (int8_float16 on CUDA, int8 on CPU), 'int8_float16', 'float16', or 'int8'
WHISPER_COMPUTE_TYPE=auto
# CPU threads for Whisper inference when running on CPU (sweet spot is physical cores, e.g., 4)
WHISPER_CPU_THREADS=4
WHISPER_PRELOAD=true
AI_MODEL_START_PERIOD=180s
DEFAULT_SOURCE_LANGUAGE=vi
DEFAULT_TARGET_LANGUAGE=ja
WS_MAX_AUDIO_FRAME_BYTES=131072
WS_MAX_TEXT_FRAME_BYTES=16384

# CLOUD STT (Groq Whisper). STT_PROVIDER: 'local' (faster-whisper CPU) or 'groq'
# (OmniLanguageRouter: vi→PhoWhisper local, others→Groq LPU with reciprocal fallback).
# Leaving GROQ_API_KEY empty keeps local STT even when STT_PROVIDER=groq.
STT_PROVIDER=local
GROQ_API_KEY=
# GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_TIMEOUT_SECONDS=3.0

# SERVICES PORTS
WEB_PORT=3000
API_PORT=5000
AI_SERVICE_PORT=8000

# CONTEXT-AWARE TRANSLATION & GLOSSARY
CONTEXTUAL_TRANSLATION_ENABLED=true
TRANSLATION_PROVIDER=contextual
TRANSLATION_MODEL=meeting-v1
TRANSLATION_TIMEOUT_MS=1000
TRANSLATION_FALLBACK_PROVIDER=local
TRANSLATION_CONTEXT_MAX_SEGMENTS=10
TRANSLATION_CACHE_ENABLED=true
TRANSLATION_SECONDARY_BACKEND=mymemory
# SPECIALIZED AI TRANSLATION PROVIDERS (Groq LPU ultra-fast primary)
DEFAULT_TRANSLATION_TIER=pro
PRO_TRANSLATION_PROVIDER=groq
PRO_GEMINI_API_KEY=
PRO_GEMINI_MODEL=gemini-2.0-flash
PRO_QWEN_API_KEY=
PRO_QWEN_MODEL=qwen-mt-turbo
PRO_BYTEPLUS_API_KEY=
PRO_BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
PRO_BYTEPLUS_MODEL=doubao-pro-32k
PRO_DEEPSEEK_API_KEY=
PRO_DEEPSEEK_MODEL=deepseek-chat
PRO_GROQ_API_KEY=
PRO_GROQ_MODEL=llama-3.3-70b-versatile
PRO_OPENAI_API_KEY=
PRO_OPENAI_MODEL=gpt-4o-mini
PRO_DEEPL_API_KEY=
PRO_MEETING_TOKEN_QUOTA=100000
PRO_GRACEFUL_DOWNGRADE_ENABLED=true
TRANSLATION_CACHE_TTL_SECONDS=86400
TRANSLATION_GLOSSARY_PATH=
TRANSLATION_GLOSSARY_VERSION=1.0.0
LAYA_TRANSLATION_CLASSIFICATION_ENABLED=true
LAYA_CLASSIFICATION_TIMEOUT_MS=100
TRANSLATION_DATASET_COLLECTION_ENABLED=false

# SUPABASE AUTH (Google OAuth 2.0)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# POLAR PAYMENTS
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=production

# NOTIFICATIONS (Telegram, Zalo, CRM Webhooks)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ZALO_WEBHOOK_URL=
ZALO_ACCESS_TOKEN=
ZALO_OA_ID=
ENTERPRISE_LEAD_WEBHOOK_URL=

