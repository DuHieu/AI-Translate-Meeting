{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Redis": {
    "ConnectionString": "redis:6379"
  },
  "LiveKit": {
    "InternalUrl": "http://livekit:7880",
    "PublicUrl": "ws://127.0.0.1:7880",
    "ApiKey": "",
    "ApiSecret": "",
    "TokenTtlMinutes": 60
  },
  "SubtitleToken": {
    "Issuer": "ai-translate-meeting-api",
    "Audience": "ai-translate-meeting-ai-service",
    "SigningKey": "",
    "TokenTtlMinutes": 10
  },
  "AdmissionToken": {
    "Issuer": "ai-translate-meeting-api",
    "Audience": "ai-translate-meeting-web",
    "SigningKey": "",
    "HostTokenTtlMinutes": 240,
    "InviteTokenTtlMinutes": 15,
    "RequestTokenTtlMinutes": 15
  },
  "SessionToken": {
    "Issuer": "ai-translate-meeting-api",
    "Audience": "ai-translate-meeting-web",
    "SigningKey": "",
    "TokenTtlMinutes": 60
  },
  "Security": {
    "EnforceProductionSecrets": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "AllowedHosts": "*"
}
