{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "LayaMeet AI Meeting",
  "version": "1.7.0",
  "identifier": "com.layameet.desktop",
  "build": {
    "beforeBuildCommand": "node prune-dist.cjs",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LayaMeet AI Meeting",
        "width": 1080,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "alwaysOnTop": false,
        "decorations": true,
        "transparent": false,
        "visible": true,
        "center": true,
        "shadow": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "LayaMeet AI Technologies",
    "copyright": "© 2026 LayaMeet AI Technologies. All rights reserved.",
    "category": "Business",
    "shortDescription": "LayaMeet - Họp trực tuyến dịch song ngữ thời gian thực",
    "longDescription": "LayaMeet Desktop: họp trực tuyến với phụ đề và dịch song ngữ thời gian thực (Việt - Nhật - Anh), nhận dạng giọng nói ngay trên máy của bạn.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "libs/*.dll": "./"
    },
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../../../scripts/sign-file.ps1",
          "%1"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": [
          "Vietnamese",
          "English",
          "Japanese"
        ],
        "startMenuFolder": "LayaMeet"
      }
    }
  }
}
