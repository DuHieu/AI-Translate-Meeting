# ==============================================================================
# Self-Hosted Deployment Profile: BUSINESS
# Target Hardware: 8 vCPU, 16 GB RAM, 50+ GB SSD
# Target Sizing: Multiple concurrent meeting rooms, active project teams.
#
# NOTE: System capacity and concurrency limits MUST be determined by load testing
# in the customer environment. Unverified throughput or accuracy guarantees are
# strictly avoided. Schedule regular backups and monitor CPU/RAM utilization.
# ==============================================================================

PROFILE=business

# Speech-to-Text Model & Runtime
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_PRELOAD=true
AI_MODEL_START_PERIOD=300s

# Laya Meeting Intelligence Sidecar
# Enabled in Business profile for automated Decision & Action Item extraction
LAYA_ENABLED=true

# Translation & Cache Settings
TRANSLATION_PROVIDER=contextual
TRANSLATION_MODEL=meeting-v1
TRANSLATION_TIMEOUT_MS=1000
TRANSLATION_FALLBACK_PROVIDER=local
TRANSLATION_CACHE_ENABLED=true
TRANSLATION_CACHE_TTL_SECONDS=86400
CONTEXTUAL_TRANSLATION_ENABLED=true

# Retention & Cleanup (Active pruning)
DATABASE_CLEANUP_ENABLED=true
DATABASE_CLEANUP_INTERVAL_HOURS=1
DATABASE_CLEANUP_RETENTION_HOURS=24

# Token Lifetimes (Minutes)
LIVEKIT_TOKEN_TTL_MINUTES=60
SUBTITLE_TOKEN_TTL_MINUTES=10
ADMISSION_HOST_TOKEN_TTL_MINUTES=240
ADMISSION_INVITE_TOKEN_TTL_MINUTES=15
SESSION_TOKEN_TTL_MINUTES=60
