# ==============================================================================
# Self-Hosted Deployment Profile: PILOT
# Target Hardware: 4 vCPU, 8 GB RAM, 25+ GB SSD
# Sizing Hypothesis: 1 concurrent active room, 3–5 participants.
#
# NOTE: This profile sizing is an initial sizing hypothesis based on early benchmarks,
# NOT a guaranteed capacity SLA. Actual capacity depends on host virtualization,
# network jitter, and participant speech overlap. Run a staging soak test to verify.
# ==============================================================================

PROFILE=pilot

# Speech-to-Text Model & Runtime
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_PRELOAD=true
AI_MODEL_START_PERIOD=180s

# Laya Meeting Intelligence Sidecar
# Disabled in Pilot profile to conserve CPU/RAM for the critical subtitle path
LAYA_ENABLED=false

# Translation & Cache Settings
TRANSLATION_PROVIDER=contextual
TRANSLATION_MODEL=meeting-v1
TRANSLATION_TIMEOUT_MS=1000
TRANSLATION_FALLBACK_PROVIDER=local
TRANSLATION_CACHE_ENABLED=true
TRANSLATION_CACHE_TTL_SECONDS=86400
CONTEXTUAL_TRANSLATION_ENABLED=true

# Retention & Cleanup
DATABASE_CLEANUP_ENABLED=true
DATABASE_CLEANUP_INTERVAL_HOURS=2
DATABASE_CLEANUP_RETENTION_HOURS=24

# Token Lifetimes (Minutes)
LIVEKIT_TOKEN_TTL_MINUTES=60
SUBTITLE_TOKEN_TTL_MINUTES=10
ADMISSION_HOST_TOKEN_TTL_MINUTES=240
ADMISSION_INVITE_TOKEN_TTL_MINUTES=15
SESSION_TOKEN_TTL_MINUTES=60
