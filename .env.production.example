# Public DNS names. Create A/AAAA records before the first deployment.
APP_DOMAIN=meet.example.com
LIVEKIT_DOMAIN=rtc.example.com

# Immutable GHCR image repositories. The workflow supplies IMAGE_TAG as a Git SHA.
API_IMAGE=ghcr.io/owner/ai-translate-meeting-api
AI_SERVICE_IMAGE=ghcr.io/owner/ai-translate-meeting-ai-service
LAYA_IMAGE=ghcr.io/owner/ai-translate-meeting-laya
WEB_IMAGE=ghcr.io/owner/ai-translate-meeting-web
IMAGE_TAG=replace-with-git-sha

# PostgreSQL. Generate a unique password; never reuse a signing key.
POSTGRES_DB=ai_translate_meeting
POSTGRES_USER=ai_translate
POSTGRES_PASSWORD=

# LiveKit credentials.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_MINUTES=60

# Distinct random values, each at least 32 characters.
SUBTITLE_TOKEN_SIGNING_KEY=
SUBTITLE_TOKEN_TTL_MINUTES=10
ADMISSION_TOKEN_SIGNING_KEY=
ADMISSION_HOST_TOKEN_TTL_MINUTES=240
ADMISSION_INVITE_TOKEN_TTL_MINUTES=15
ADMISSION_REQUEST_TOKEN_TTL_MINUTES=15
SESSION_TOKEN_SIGNING_KEY=
SESSION_TOKEN_TTL_MINUTES=60

# Room capacity (plan: 20–30 rooms / ~500 CCU).
DEFAULT_MAX_ROOMS=25
DEFAULT_MAX_PARTICIPANTS=50

# AI runtime sizing.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Production Omni-Router: set STT_PROVIDER=groq and inject GROQ_API_KEY on the VPS.
STT_PROVIDER=groq
GROQ_API_KEY=
# GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_TIMEOUT_SECONDS=3.0
AI_MODEL_START_PERIOD=300s
LAYA_ENABLED=true
WS_MAX_AUDIO_FRAME_BYTES=131072
WS_MAX_TEXT_FRAME_BYTES=16384
CONTEXTUAL_TRANSLATION_ENABLED=true
TRANSLATION_PROVIDER=contextual
TRANSLATION_MODEL=meeting-v1
TRANSLATION_TIMEOUT_MS=1000
TRANSLATION_FALLBACK_PROVIDER=local
TRANSLATION_CACHE_ENABLED=true
TRANSLATION_CACHE_TTL_SECONDS=86400

# Polar Payments
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=production

# Admin Portal Secret Key (X-Admin-Key)
ADMIN_SECRET_KEY=vimeet-admin-secret-2026

