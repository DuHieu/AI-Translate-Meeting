# CI-only defaults for GitHub Actions E2E (not for production deploy).
POSTGRES_DB=ai_translate_meeting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ci_e2e_postgres_password
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

LIVEKIT_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=ci_e2e_livekit_secret_value_32chars_min
LIVEKIT_TOKEN_TTL_MINUTES=60

SUBTITLE_TOKEN_SIGNING_KEY=ci_e2e_subtitle_signing_key_32chars_xx
SUBTITLE_TOKEN_TTL_MINUTES=10

ADMISSION_TOKEN_SIGNING_KEY=ci_e2e_admission_signing_key_32chars_x
ADMISSION_HOST_TOKEN_TTL_MINUTES=240
ADMISSION_INVITE_TOKEN_TTL_MINUTES=15
ADMISSION_REQUEST_TOKEN_TTL_MINUTES=15

SESSION_TOKEN_SIGNING_KEY=ci_e2e_session_signing_key_32chars_xxx
SESSION_TOKEN_TTL_MINUTES=60

WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2
WHISPER_PRELOAD=true
AI_MODEL_START_PERIOD=240s

WEB_ORIGIN=http://localhost:3000
WEB_PORT=3000
API_PORT=5000
AI_SERVICE_PORT=8000

CONTEXTUAL_TRANSLATION_ENABLED=true
TRANSLATION_PROVIDER=local
TRANSLATION_FALLBACK_PROVIDER=local
TRANSLATION_CACHE_ENABLED=false
PRO_TRANSLATION_PROVIDER=local
LAYA_ENABLED=false
LAYA_TRANSLATION_CLASSIFICATION_ENABLED=false

LICENSE_MAX_ROOMS=25
LICENSE_MAX_PARTICIPANTS=20
